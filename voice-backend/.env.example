# HTTP API
VOICE_BACKEND_HOST=0.0.0.0
VOICE_BACKEND_PORT=8090

# Audio
VOICE_SAMPLE_RATE=16000
VOICE_CHANNELS=1
VOICE_BLOCK_SIZE=1280
# Raise the threshold if the wake word false-triggers on room noise
VOICE_WAKE_THRESHOLD=0.6
VOICE_RMS_THRESHOLD=700.0
VOICE_SILENCE_SECONDS=1.2
VOICE_MIN_SPEECH_SECONDS=0.7
VOICE_MAX_SPEECH_SECONDS=8.0
# Give up listening if nobody starts speaking within this time after wake word
VOICE_PRE_SPEECH_TIMEOUT_SECONDS=2.5
# Discard buffered mic audio (TTS echo) after each reply
VOICE_POST_REPLY_FLUSH_SECONDS=1.2
VOICE_WAKE_COOLDOWN_SECONDS=3.5
# Ignore the wake word for this long after Alpha finishes replying
VOICE_POST_REPLY_QUIET_SECONDS=4.0

# Wake word (optional custom model)
# If empty, openWakeWord default models are used (e.g. hey_jarvis)
VOICE_WAKEWORD_MODEL_PATH=
VOICE_WAKEWORD_MODEL_NAME=hey_jarvis

# Vosk STT (required)
# Relative paths are anchored to voice-backend/ (e.g. models/vosk/...)
VOSK_MODEL_PATH=models/vosk/vosk-model-small-es-0.42

# Groq LLM (OpenAI-compatible API)
GROQ_API_KEY=
GROQ_MODEL=groq/compound-mini
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_TIMEOUT_SECONDS=20

# Piper TTS
PIPER_MODEL_PATH=models/piper/es_ES-davefx-medium.onnx
PIPER_BIN=./.venv/bin/piper
PIPER_PLAY_COMMAND="aplay -q"

# Tool actions
SPOTIFY_PLAY_COMMAND=
SPOTIFY_PAUSE_COMMAND=
NOTIFY_URL=http://127.0.0.1:8080/notify
NOTIFY_API_KEY=nuria-assistant-secret-key

# Optional WS2812 ring feedback
LED_ENABLED=false
LED_PIN=18
LED_COUNT=12
LED_BRIGHTNESS=80
