# HTTP API
VOICE_BACKEND_HOST=0.0.0.0
VOICE_BACKEND_PORT=8090

# Audio
VOICE_SAMPLE_RATE=16000
VOICE_CHANNELS=1
VOICE_BLOCK_SIZE=1280
VOICE_WAKE_THRESHOLD=0.45
VOICE_RMS_THRESHOLD=500.0
VOICE_SILENCE_SECONDS=1.2
VOICE_MIN_SPEECH_SECONDS=0.7
VOICE_MAX_SPEECH_SECONDS=8.0
VOICE_WAKE_COOLDOWN_SECONDS=2.5

# Wake word (optional custom model)
# If empty, openWakeWord default models are used (e.g. hey_jarvis)
VOICE_WAKEWORD_MODEL_PATH=
VOICE_WAKEWORD_MODEL_NAME=hey_jarvis

# Vosk STT (required)
# Example: /opt/vosk-model-small-es-0.42
VOSK_MODEL_PATH=/opt/vosk-model-small-es-0.42

# Groq LLM (OpenAI-compatible API)
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_TIMEOUT_SECONDS=20

# Piper TTS
PIPER_MODEL_PATH=/opt/piper/es_ES-davefx-medium.onnx
PIPER_BIN=/opt/voice-backend/.venv/bin/piper
PIPER_PLAY_COMMAND="aplay -q"

# Tool actions
SPOTIFY_PLAY_COMMAND=
SPOTIFY_PAUSE_COMMAND=
NOTIFY_URL=http://127.0.0.1:8080/notify
NOTIFY_API_KEY=nuria-assistant-secret-key

# Optional WS2812 ring feedback
LED_ENABLED=false
LED_PIN=18
LED_COUNT=12
LED_BRIGHTNESS=80
