# Copy this file to config.properties and add your local credentials.
OPENWEATHER_API_KEY=
OPENWEATHER_CITY=Granada,ES

SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Desktop/loopback fallback (the only plain-http redirect Spotify still accepts).
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback
# HTTPS bounce page used by the phone QR login (see docs/spotify-callback.html).
# Whitelist the exact URL as a Redirect URI in the Spotify Developer Dashboard.
SPOTIFY_RELAY_URL=https://hcaroli381.github.io/NuriaAssistant/spotify-callback.html

# Optional: name Alpha greets on the alarm screen (default: Nuria)
OWNER_NAME=Nuria

TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_ID=

# Public read-only iCloud calendar (.ics) share link. Empty = calendar off.
# It can also be set at runtime by sending /calendario <enlace> to the bot;
# that value is stored in ~/.alpha/settings.json and wins over this file.
CALENDAR_ICS_URL=

# Night dimming (screen saver): dim after N idle minutes between these hours
DIM_IDLE_MINUTES=10
DIM_START_HOUR=22
DIM_END_HOUR=8
