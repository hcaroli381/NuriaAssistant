<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>

<AnchorPane fx:id="rootPane"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.nuriaassistant.AssistantController"
            prefWidth="1024.0" prefHeight="600.0"
            style="-fx-background-color: radial-gradient(focus-angle 0.0deg, focus-distance 0.0%, center 20.0% 20.0%, radius 100.0%, #132a4a 0.0%, #0a192f 50.0%, #050d18 100.0%);"
            styleClass="root-container"
            stylesheets="@styles.css">

    <!-- Home Layer: Top-Left Minimalist Time, Date & Weather Display -->
    <AnchorPane fx:id="homeLayer"
                AnchorPane.topAnchor="0.0" AnchorPane.bottomAnchor="0.0"
                AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0">

        <!-- Top-Left Main Info Block: Time, Date, Weather & Temperature -->
        <VBox alignment="TOP_LEFT" spacing="6.0"
              AnchorPane.topAnchor="40.0"
              AnchorPane.leftAnchor="48.0">

            <!-- 1. Real-time Clock (Crisp, High-Contrast White) -->
            <Label fx:id="timeLabel"
                   text="--:--:--"
                   styleClass="minimal-clock"/>

            <!-- 2. Date: Day of the week + Day + Month (Vivid Sky Blue) -->
            <Label fx:id="dateLabel"
                   text="Loading date..."
                   styleClass="minimal-date"/>

            <!-- 3. Weather & Temperature Row (Integrated right under date) -->
            <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="minimal-weather-row">
                <Label fx:id="weatherIconLabel"
                       text="☀️"
                       styleClass="minimal-weather-icon"/>

                <Label fx:id="weatherTempLabel"
                       text="--°C"
                       styleClass="minimal-weather-temp"/>

                <Label text="•" styleClass="minimal-weather-dot"/>

                <Label fx:id="weatherDescLabel"
                       text="Fetching weather..."
                       styleClass="minimal-weather-desc"/>

                <Label text="•" styleClass="minimal-weather-dot"/>

                <Label fx:id="weatherCityLabel"
                       text="Granada"
                       styleClass="minimal-weather-city"/>
            </HBox>
        </VBox>

        <!-- Notification Banner at Bottom (Sticky Note - Persists until tapped or cleared via Telegram) -->
        <HBox fx:id="notificationBanner"
              visible="false"
              alignment="CENTER_LEFT" spacing="14.0"
              styleClass="notification-banner"
              AnchorPane.bottomAnchor="30.0"
              AnchorPane.leftAnchor="48.0"
              AnchorPane.rightAnchor="48.0">

            <Label text="🔔" style="-fx-font-size: 22px;"/>
            <Label fx:id="notificationLabel"
                   text=""
                   styleClass="notification-text"
                   wrapText="true"
                   HBox.hgrow="ALWAYS"/>

            <!-- Spacer -->
            <HBox HBox.hgrow="ALWAYS"/>

            <!-- Touch Dismiss Button -->
            <Label text="✕"
                   onMouseClicked="#dismissNotification"
                   styleClass="notification-close-btn"/>
        </HBox>
    </AnchorPane>

    <!-- Spotify Full Screen Layer (Activated when Spotify is playing) -->
    <AnchorPane fx:id="spotifyFullScreenLayer"
                visible="false" opacity="0.0"
                styleClass="spotify-background"
                AnchorPane.topAnchor="0.0" AnchorPane.bottomAnchor="0.0"
                AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0">

        <!-- Header: Speaker Device Info & Spotify Brand -->
        <HBox alignment="CENTER_LEFT" spacing="15.0"
              AnchorPane.topAnchor="24.0"
              AnchorPane.leftAnchor="36.0"
              AnchorPane.rightAnchor="36.0">

            <!-- Speaker Indicator Badge -->
            <HBox alignment="CENTER_LEFT" spacing="10.0"
                  styleClass="spotify-speaker-badge">
                <Label text="🔊" style="-fx-font-size: 16px;"/>
                <Label fx:id="spotifySpeakerLabel"
                       text="Raspberry Pi Speaker"
                       styleClass="spotify-speaker-text"/>
            </HBox>

            <!-- Spacer -->
            <HBox HBox.hgrow="ALWAYS"/>

            <!-- Small Spotify Logo Top Right -->
            <HBox alignment="CENTER" spacing="8.0">
                <SVGPath content="M12 0C5.373 0 0 5.373 0 12s5.373 12 12 12 12-5.373 12-12S18.627 0 12 0zm5.508 17.302c-.216.353-.674.468-1.027.252-2.822-1.724-6.375-2.114-10.559-1.158-.403.092-.807-.16-.899-.562-.092-.403.16-.807.562-.899 4.582-1.047 8.513-.598 11.671 1.34.353.216.468.674.252 1.027zm1.47-3.262c-.272.443-.852.585-1.295.313-3.23-1.986-8.156-2.56-11.977-1.399-.499.151-1.031-.131-1.182-.63-.151-.499.131-1.031.63-1.182 4.373-1.328 9.805-.688 13.511 1.593.443.272.585.852.313 1.295zm.126-3.411c-3.874-2.3-10.264-2.512-13.966-1.388-.593.18-1.226-.156-1.406-.749-.18-.593.156-1.226.749-1.406 4.251-1.291 11.31-1.043 15.772 1.606.533.317.708 1.008.391 1.541-.317.533-1.008.708-1.54.391z"
                         fill="#1DB954" scaleX="1.2" scaleY="1.2"/>
                <Label text="Spotify"
                       style="-fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold;"/>
            </HBox>
        </HBox>

        <!-- Main Content: Cover Art + Song Info -->
        <HBox alignment="CENTER_LEFT" spacing="45.0"
              AnchorPane.topAnchor="85.0" AnchorPane.bottomAnchor="35.0"
              AnchorPane.leftAnchor="45.0" AnchorPane.rightAnchor="45.0">

            <!-- Album Cover Container -->
            <StackPane prefWidth="320.0" prefHeight="320.0"
                       styleClass="spotify-art-card">
                <Label text="🎵" style="-fx-font-size: 64px; -fx-text-fill: #333d47;"/>
                <ImageView fx:id="spotifyCoverArtView"
                           fitWidth="320.0" fitHeight="320.0"
                           preserveRatio="true"
                           smooth="true"/>
            </StackPane>

            <!-- Song, Artist, Album Info -->
            <VBox alignment="CENTER_LEFT" spacing="12.0" HBox.hgrow="ALWAYS">
                <Label fx:id="spotifyStatusLabel"
                       text="NOW PLAYING"
                       styleClass="spotify-status-tag"/>

                <Label fx:id="spotifySongNameLabel"
                       text="Song Name"
                       wrapText="true"
                       styleClass="spotify-song-title"/>

                <Label fx:id="spotifyArtistNameLabel"
                       text="Artist Name"
                       wrapText="true"
                       styleClass="spotify-artist-title"/>

                <Label fx:id="spotifyAlbumNameLabel"
                       text="Album Name"
                       wrapText="true"
                       styleClass="spotify-album-title"/>
            </VBox>
        </HBox>
    </AnchorPane>

    <!-- Spotify Intro Transition Overlay (Pop-up Logo animation before full screen mode) -->
    <StackPane fx:id="spotifyIntroLayer"
                visible="false" opacity="0.0"
                mouseTransparent="true"
                style="-fx-background-color: rgba(0, 0, 0, 0.88);"
                AnchorPane.topAnchor="0.0" AnchorPane.bottomAnchor="0.0"
                AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0">

        <VBox alignment="CENTER" spacing="20.0">
            <SVGPath fx:id="spotifyIntroLogo"
                     content="M12 0C5.373 0 0 5.373 0 12s5.373 12 12 12 12-5.373 12-12S18.627 0 12 0zm5.508 17.302c-.216.353-.674.468-1.027.252-2.822-1.724-6.375-2.114-10.559-1.158-.403.092-.807-.16-.899-.562-.092-.403.16-.807.562-.899 4.582-1.047 8.513-.598 11.671 1.34.353.216.468.674.252 1.027zm1.47-3.262c-.272.443-.852.585-1.295.313-3.23-1.986-8.156-2.56-11.977-1.399-.499.151-1.031-.131-1.182-.63-.151-.499.131-1.031.63-1.182 4.373-1.328 9.805-.688 13.511 1.593.443.272.585.852.313 1.295zm.126-3.411c-3.874-2.3-10.264-2.512-13.966-1.388-.593.18-1.226-.156-1.406-.749-.18-.593.156-1.226.749-1.406 4.251-1.291 11.31-1.043 15.772 1.606.533.317.708 1.008.391 1.541-.317.533-1.008.708-1.54.391z"
                     fill="#1DB954" scaleX="6.0" scaleY="6.0"/>

            <Label text="Spotify Connect"
                   style="-fx-text-fill: #1DB954; -fx-font-size: 26px; -fx-font-weight: bold; -fx-padding: 30px 0 0 0;"/>
            <Label text="Raspberry Pi Speaker Active"
                   style="-fx-text-fill: #94a3b8; -fx-font-size: 16px;"/>
        </VBox>
    </StackPane>

</AnchorPane>
