<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.Group?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.shape.Line?>
<?import javafx.scene.shape.Rectangle?>
<?import javafx.scene.shape.SVGPath?>

<AnchorPane fx:id="rootPane"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.nuriaassistant.AssistantController"
            prefWidth="1024.0" prefHeight="600.0"
            styleClass="root-container"
            stylesheets="@styles.css">

    <!-- Home Layer: Top-Left Minimalist Time, Date & Weather Display -->
    <AnchorPane fx:id="homeLayer"
                AnchorPane.topAnchor="0.0" AnchorPane.bottomAnchor="0.0"
                AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0">

        <!-- Alpha's sky: a hand-placed constellation that gives the empty half of
             the screen a reason to exist. 15 tiny static shapes, drawn once. -->
        <Group mouseTransparent="true">
            <Line startX="612.0" startY="452.0" endX="668.0" endY="512.0" styleClass="star-line"/>
            <Line startX="668.0" startY="512.0" endX="742.0" endY="468.0" styleClass="star-line"/>
            <Line startX="742.0" startY="468.0" endX="806.0" endY="540.0" styleClass="star-line"/>
            <Line startX="806.0" startY="540.0" endX="884.0" endY="494.0" styleClass="star-line"/>
            <Line startX="884.0" startY="494.0" endX="938.0" endY="560.0" styleClass="star-line"/>
            <Line startX="700.0" startY="392.0" endX="742.0" endY="468.0" styleClass="star-line"/>

            <Circle centerX="700.0" centerY="392.0" radius="1.3" styleClass="star"/>
            <Circle centerX="612.0" centerY="452.0" radius="1.6" styleClass="star"/>
            <Circle centerX="668.0" centerY="512.0" radius="1.1" styleClass="star"/>
            <Circle centerX="742.0" centerY="468.0" radius="2.3" styleClass="star-iris"/>
            <Circle centerX="806.0" centerY="540.0" radius="1.4" styleClass="star"/>
            <Circle centerX="884.0" centerY="494.0" radius="1.9" styleClass="star"/>
            <Circle centerX="938.0" centerY="560.0" radius="1.1" styleClass="star"/>
            <Circle centerX="396.0" centerY="474.0" radius="1.5" styleClass="star"/>
            <Circle centerX="318.0" centerY="534.0" radius="1.1" styleClass="star"/>
            <Circle centerX="466.0" centerY="556.0" radius="1.3" styleClass="star"/>

            <!-- One long ring: the orbit her stars sit on -->
            <Circle centerX="786.0" centerY="500.0" radius="132.0" styleClass="star-ring"/>
        </Group>

        <!-- Dusk vignette: pulls the corners down so the middle of the screen breathes -->
        <Region mouseTransparent="true"
                styleClass="home-vignette"
                AnchorPane.topAnchor="0.0" AnchorPane.bottomAnchor="0.0"
                AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0"/>

        <!-- Top-Left Main Info Block: Time, Date, Weather & Temperature -->
        <VBox alignment="TOP_LEFT" spacing="6.0"
              AnchorPane.topAnchor="40.0"
              AnchorPane.leftAnchor="48.0">

            <!-- 1. Real-time Clock (Crisp, High-Contrast White) -->
            <Label fx:id="timeLabel"
                   text="--:--:--"
                   styleClass="minimal-clock"/>

            <!-- 2. Date: Day of the week + Day + Month (Vivid Sky Blue) -->
            <Label fx:id="dateLabel"
                   text="Loading date..."
                   styleClass="minimal-date"/>

            <!-- 3. Weather & Temperature Row (Integrated right under date) -->
            <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="minimal-weather-row">
                <!-- Conditions glyph, built from shapes by WeatherUi (no emoji) -->
                <StackPane fx:id="weatherIconBox"
                           prefWidth="30.0" prefHeight="30.0"/>

                <Label fx:id="weatherTempLabel"
                       text="--°C"
                       styleClass="minimal-weather-temp"/>

                <Label text="•" styleClass="minimal-weather-dot"/>

                <Label fx:id="weatherDescLabel"
                       text="Fetching weather..."
                       styleClass="minimal-weather-desc"/>

                <Label text="•" styleClass="minimal-weather-dot"/>

                <Label fx:id="weatherCityLabel"
                       text="Granada"
                       styleClass="minimal-weather-city"/>
            </HBox>

            <!-- 4. Next Alarm Hint (subtle, under weather row) -->
            <HBox fx:id="nextAlarmRow" visible="false"
                  alignment="CENTER_LEFT" spacing="9.0">
                <Pane prefWidth="17.0" prefHeight="17.0" mouseTransparent="true">
                    <Circle centerX="8.5" centerY="9.5" radius="5.3" styleClass="icon-line icon-line-ember"/>
                    <Line startX="8.5" startY="9.5" endX="8.5" endY="6.4" styleClass="icon-line icon-line-ember"/>
                    <Line startX="8.5" startY="9.5" endX="10.9" endY="10.9" styleClass="icon-line icon-line-ember"/>
                </Pane>
                <Label fx:id="nextAlarmLabel"
                       text=""
                       styleClass="next-alarm-text"/>
            </HBox>

            <!-- 5. Next Calendar Event Hint (subtle, same family) -->
            <HBox fx:id="nextEventRow" visible="false"
                  alignment="CENTER_LEFT" spacing="9.0">
                <Pane prefWidth="17.0" prefHeight="17.0" mouseTransparent="true">
                    <Rectangle x="1.4" y="3.2" width="14.2" height="12.4" arcWidth="4.0" arcHeight="4.0"
                               styleClass="icon-line icon-line-iris"/>
                    <Line startX="1.4" startY="7.0" endX="15.6" endY="7.0" styleClass="icon-line icon-line-iris"/>
                    <Line startX="5.0" startY="1.4" endX="5.0" endY="4.4" styleClass="icon-line icon-line-iris"/>
                    <Line startX="12.0" startY="1.4" endX="12.0" endY="4.4" styleClass="icon-line icon-line-iris"/>
                </Pane>
                <Label fx:id="nextEventLabel"
                       text=""
                       styleClass="next-event-text"/>
            </HBox>
        </VBox>

        <!-- Alpha signs the home screen: her mark and her name, bottom-left -->
        <HBox alignment="CENTER_LEFT" spacing="13.0"
              mouseTransparent="true"
              AnchorPane.bottomAnchor="24.0"
              AnchorPane.leftAnchor="48.0">
            <StackPane>
                <Circle radius="13.0" styleClass="alpha-mark-halo"/>
                <Circle radius="5.6" styleClass="alpha-mark-core"/>
                <Circle radius="2.0" styleClass="alpha-mark-dot"/>
            </StackPane>
            <VBox spacing="0.0" alignment="CENTER_LEFT">
                <Label text="A L P H A" styleClass="alpha-wordmark"/>
                <Label text="asistente de casa" styleClass="alpha-wordmark-sub"/>
            </VBox>
        </HBox>
    </AnchorPane>

    <!-- Spotify Full Screen Layer (Activated when Spotify is playing) -->
    <AnchorPane fx:id="spotifyFullScreenLayer"
                visible="false" opacity="0.0"
                styleClass="spotify-background"
                AnchorPane.topAnchor="0.0" AnchorPane.bottomAnchor="0.0"
                AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0">

        <!-- Header: Speaker Device Info & Spotify Brand -->
        <HBox alignment="CENTER_LEFT" spacing="15.0"
              AnchorPane.topAnchor="24.0"
              AnchorPane.leftAnchor="36.0"
              AnchorPane.rightAnchor="36.0">

            <!-- Speaker Indicator Badge -->
            <HBox alignment="CENTER_LEFT" spacing="10.0"
                  styleClass="spotify-speaker-badge">
                <Label text="🔊" styleClass="spotify-speaker-icon"/>
                <Label fx:id="spotifySpeakerLabel"
                       text="Raspberry Pi Speaker"
                       styleClass="spotify-speaker-text"/>
            </HBox>

            <!-- Spacer -->
            <HBox HBox.hgrow="ALWAYS"/>

            <!-- Small Spotify Logo Top Right -->
            <HBox alignment="CENTER" spacing="8.0">
                <SVGPath content="M12 0C5.373 0 0 5.373 0 12s5.373 12 12 12 12-5.373 12-12S18.627 0 12 0zm5.508 17.302c-.216.353-.674.468-1.027.252-2.822-1.724-6.375-2.114-10.559-1.158-.403.092-.807-.16-.899-.562-.092-.403.16-.807.562-.899 4.582-1.047 8.513-.598 11.671 1.34.353.216.468.674.252 1.027zm1.47-3.262c-.272.443-.852.585-1.295.313-3.23-1.986-8.156-2.56-11.977-1.399-.499.151-1.031-.131-1.182-.63-.151-.499.131-1.031.63-1.182 4.373-1.328 9.805-.688 13.511 1.593.443.272.585.852.313 1.295zm.126-3.411c-3.874-2.3-10.264-2.512-13.966-1.388-.593.18-1.226-.156-1.406-.749-.18-.593.156-1.226.749-1.406 4.251-1.291 11.31-1.043 15.772 1.606.533.317.708 1.008.391 1.541-.317.533-1.008.708-1.54.391z"
                         fill="#1DB954" scaleX="1.2" scaleY="1.2"/>
                <Label text="Spotify"
                       styleClass="spotify-brand-text"/>
            </HBox>
        </HBox>

        <!-- Main Content: Cover Art + Song Info -->
        <HBox alignment="CENTER_LEFT" spacing="45.0"
              AnchorPane.topAnchor="85.0" AnchorPane.bottomAnchor="35.0"
              AnchorPane.leftAnchor="45.0" AnchorPane.rightAnchor="45.0">

            <!-- Album Cover Container -->
            <StackPane prefWidth="320.0" prefHeight="320.0"
                       styleClass="spotify-art-card">
                <Label text="🎵" styleClass="spotify-art-placeholder"/>
                <ImageView fx:id="spotifyCoverArtView"
                           fitWidth="320.0" fitHeight="320.0"
                           preserveRatio="true"
                           smooth="true"/>
            </StackPane>

            <!-- Song, Artist, Album Info -->
            <VBox alignment="CENTER_LEFT" spacing="12.0" HBox.hgrow="ALWAYS">
                <Label fx:id="spotifyStatusLabel"
                       text="NOW PLAYING"
                       styleClass="spotify-status-tag"/>

                <Label fx:id="spotifySongNameLabel"
                       text="Song Name"
                       wrapText="true"
                       styleClass="spotify-song-title"/>

                <Label fx:id="spotifyArtistNameLabel"
                       text="Artist Name"
                       wrapText="true"
                       styleClass="spotify-artist-title"/>

                <Label fx:id="spotifyAlbumNameLabel"
                       text="Album Name"
                       wrapText="true"
                       styleClass="spotify-album-title"/>
            </VBox>
        </HBox>
    </AnchorPane>

    <!-- Spotify Intro Transition Overlay (Pop-up Logo animation before full screen mode) -->
    <StackPane fx:id="spotifyIntroLayer"
                visible="false" opacity="0.0"
                mouseTransparent="true"
                styleClass="spotify-intro-backdrop"
                AnchorPane.topAnchor="0.0" AnchorPane.bottomAnchor="0.0"
                AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0">

        <VBox alignment="CENTER" spacing="20.0">
            <SVGPath fx:id="spotifyIntroLogo"
                     content="M12 0C5.373 0 0 5.373 0 12s5.373 12 12 12 12-5.373 12-12S18.627 0 12 0zm5.508 17.302c-.216.353-.674.468-1.027.252-2.822-1.724-6.375-2.114-10.559-1.158-.403.092-.807-.16-.899-.562-.092-.403.16-.807.562-.899 4.582-1.047 8.513-.598 11.671 1.34.353.216.468.674.252 1.027zm1.47-3.262c-.272.443-.852.585-1.295.313-3.23-1.986-8.156-2.56-11.977-1.399-.499.151-1.031-.131-1.182-.63-.151-.499.131-1.031.63-1.182 4.373-1.328 9.805-.688 13.511 1.593.443.272.585.852.313 1.295zm.126-3.411c-3.874-2.3-10.264-2.512-13.966-1.388-.593.18-1.226-.156-1.406-.749-.18-.593.156-1.226.749-1.406 4.251-1.291 11.31-1.043 15.772 1.606.533.317.708 1.008.391 1.541-.317.533-1.008.708-1.54.391z"
                     fill="#1DB954" scaleX="6.0" scaleY="6.0"/>

            <Label text="Spotify Connect"
                   styleClass="spotify-intro-title"/>
            <Label text="Raspberry Pi Speaker Active"
                   styleClass="spotify-intro-subtitle"/>
        </VBox>
    </StackPane>

    <!-- Voice Assistant Overlay (Topmost: ambient orb + expandable conversation card) -->
    <AnchorPane fx:id="voiceOverlayLayer"
                visible="false"
                AnchorPane.topAnchor="0.0" AnchorPane.bottomAnchor="0.0"
                AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0">

        <!-- Top-Right Row: Alarm Clock Button + Spotify Link Button + Ambient Mic Orb / Mute Button -->
        <HBox alignment="CENTER_LEFT" spacing="14.0"
              AnchorPane.topAnchor="26.0"
              AnchorPane.rightAnchor="30.0">

            <!-- Alarms Entry (clock icon, opens manager sheet) -->
            <HBox alignment="CENTER"
                  styleClass="alarm-clock-button"
                  onMouseClicked="#openAlarmManager">
                <Pane prefWidth="26.0" prefHeight="26.0" scaleX="1.3" scaleY="1.3" mouseTransparent="true">
                    <Circle centerX="13.0" centerY="14.2" radius="7.8" styleClass="icon-line icon-line-ember"/>
                    <Line startX="13.0" startY="14.2" endX="13.0" endY="9.4" styleClass="icon-line icon-line-ember"/>
                    <Line startX="13.0" startY="14.2" endX="16.6" endY="16.3" styleClass="icon-line icon-line-ember"/>
                    <Line startX="5.4" startY="3.8" endX="9.2" endY="7.6" styleClass="icon-line icon-line-ember"/>
                    <Line startX="20.6" startY="3.8" endX="16.8" endY="7.6" styleClass="icon-line icon-line-ember"/>
                </Pane>
            </HBox>

            <!-- Spotify Link Entry (Spotify icon, opens QR login sheet) -->
            <HBox alignment="CENTER"
                  styleClass="spotify-link-button"
                  onMouseClicked="#openSpotifyAuth">
                <SVGPath content="M12 0C5.373 0 0 5.373 0 12s5.373 12 12 12 12-5.373 12-12S18.627 0 12 0zm5.508 17.302c-.216.353-.674.468-1.027.252-2.822-1.724-6.375-2.114-10.559-1.158-.403.092-.807-.16-.899-.562-.092-.403.16-.807.562-.899 4.582-1.047 8.513-.598 11.671 1.34.353.216.468.674.252 1.027zm1.47-3.262c-.272.443-.852.585-1.295.313-3.23-1.986-8.156-2.56-11.977-1.399-.499.151-1.031-.131-1.182-.63-.151-.499.131-1.031.63-1.182 4.373-1.328 9.805-.688 13.511 1.593.443.272.585.852.313 1.295zm.126-3.411c-3.874-2.3-10.264-2.512-13.966-1.388-.593.18-1.226-.156-1.406-.749-.18-.593.156-1.226.749-1.406 4.251-1.291 11.31-1.043 15.772 1.606.533.317.708 1.008.391 1.541-.317.533-1.008.708-1.54.391z"
                         fill="#1DB954" scaleX="1.35" scaleY="1.35"/>
            </HBox>

            <!-- Calendar Entry (calendar icon + upcoming-events badge, opens the full-screen agenda) -->
            <HBox alignment="CENTER"
                  styleClass="calendar-button"
                  onMouseClicked="#openCalendarScreen">
                <StackPane>
                    <Pane prefWidth="26.0" prefHeight="26.0" scaleX="1.3" scaleY="1.3" mouseTransparent="true">
                        <Rectangle x="2.2" y="4.4" width="21.6" height="18.6"
                                   arcWidth="6.0" arcHeight="6.0"
                                   styleClass="icon-line icon-line-iris"/>
                        <Line startX="2.2" startY="9.8" endX="23.8" endY="9.8"
                              styleClass="icon-line icon-line-iris"/>
                        <Line startX="7.6" startY="1.8" endX="7.6" endY="6.4"
                              styleClass="icon-line icon-line-iris"/>
                        <Line startX="18.4" startY="1.8" endX="18.4" endY="6.4"
                              styleClass="icon-line icon-line-iris"/>
                        <Line startX="7.2" startY="13.6" endX="11.0" endY="13.6"
                              styleClass="icon-line icon-line-iris"/>
                        <Line startX="13.0" startY="13.6" endX="16.8" endY="13.6"
                              styleClass="icon-line icon-line-iris"/>
                    </Pane>
                    <Label fx:id="calendarBadgeLabel" visible="false"
                           text="0"
                           StackPane.alignment="TOP_RIGHT"
                           translateX="10.0" translateY="-3.0"
                           styleClass="calendar-badge"/>
                </StackPane>
            </HBox>

            <!-- Ambient Mic Orb / Mute Button (Collapsed state) -->
            <HBox fx:id="voiceOrb" alignment="CENTER" spacing="8.0"
                  styleClass="voice-orb"
                  onMouseClicked="#toggleVoiceMute">
                <SVGPath fx:id="voiceMicIcon"
                         content="M12 3.4c1.77 0 3.2 1.43 3.2 3.2v4.8c0 1.77-1.43 3.2-3.2 3.2s-3.2-1.43-3.2-3.2V6.6c0-1.77 1.43-3.2 3.2-3.2Z M7.6 13.2v1.8h8.8v-1.8 M12 15v4.6 M8.8 19.6h6.4"
                         scaleX="1.3" scaleY="1.3"
                         styleClass="mic-glyph"/>
                <SVGPath fx:id="voiceMicOffIcon"
                         visible="false"
                         content="M12 3.4c1.77 0 3.2 1.43 3.2 3.2v4.8c0 1.77-1.43 3.2-3.2 3.2s-3.2-1.43-3.2-3.2V6.6c0-1.77 1.43-3.2 3.2-3.2Z M7.6 13.2v1.8h8.8v-1.8 M12 15v4.6 M8.8 19.6h6.4 M4.4 4.2 19.6 19.4"
                         scaleX="1.3" scaleY="1.3"
                         styleClass="mic-glyph mic-glyph-muted"/>
            </HBox>
        </HBox>

        <!-- Conversation Card (Expanded state, rises from bottom center) -->
        <HBox alignment="CENTER"
              AnchorPane.bottomAnchor="30.0"
              AnchorPane.leftAnchor="140.0"
              AnchorPane.rightAnchor="140.0">

            <VBox fx:id="voiceCard"
                  visible="false" opacity="0.0"
                  alignment="CENTER_LEFT" spacing="10.0"
                  maxWidth="700.0"
                  styleClass="voice-card">

                <!-- Status Row: Mic Icon + State Text + Thinking Dots -->
                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <SVGPath fx:id="voiceCardMicIcon"
                             content="M12 3.4c1.77 0 3.2 1.43 3.2 3.2v4.8c0 1.77-1.43 3.2-3.2 3.2s-3.2-1.43-3.2-3.2V6.6c0-1.77 1.43-3.2 3.2-3.2Z M7.6 13.2v1.8h8.8v-1.8 M12 15v4.6 M8.8 19.6h6.4"
                             scaleX="1.1" scaleY="1.1"
                             styleClass="mic-glyph"/>
                    <Label fx:id="voiceStatusLabel"
                           text="Lista"
                           styleClass="voice-status-text"/>
                    <HBox fx:id="voiceDotsRow" alignment="CENTER_LEFT" spacing="4.0" visible="false">
                        <Label fx:id="voiceDot1" text="&#9679;" styleClass="voice-thinking-dot"/>
                        <Label fx:id="voiceDot2" text="&#9679;" styleClass="voice-thinking-dot"/>
                        <Label fx:id="voiceDot3" text="&#9679;" styleClass="voice-thinking-dot"/>
                    </HBox>
                </HBox>

                <!-- User Transcript Bubble -->
                <VBox fx:id="voiceTranscriptBubble"
                      visible="false"
                      alignment="CENTER_LEFT" spacing="2.0"
                      maxWidth="650.0"
                      styleClass="voice-bubble-user">
                    <Label text="T&#218;" styleClass="voice-bubble-user-author"/>
                    <Label fx:id="voiceTranscriptLabel"
                           text=""
                           wrapText="true"
                           styleClass="voice-bubble-text"/>
                </VBox>

                <!-- Alpha Reply Bubble -->
                <VBox fx:id="voiceReplyBubble"
                      visible="false"
                      alignment="CENTER_LEFT" spacing="2.0"
                      maxWidth="650.0"
                      styleClass="voice-bubble-alpha">
                    <Label text="A L P H A" styleClass="voice-bubble-alpha-author"/>
                    <Label fx:id="voiceReplyLabel"
                           text=""
                           wrapText="true"
                           styleClass="voice-bubble-text"/>
                </VBox>
            </VBox>
        </HBox>
    </AnchorPane>

    <!-- Spotify QR Login Sheet (Modal: scan with the phone to authorize) -->
    <AnchorPane fx:id="spotifyAuthLayer"
                visible="false"
                styleClass="alarm-sheet-backdrop"
                onMouseClicked="#closeSpotifyAuthOnOutsideClick"
                AnchorPane.topAnchor="0.0" AnchorPane.bottomAnchor="0.0"
                AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0">

        <VBox fx:id="spotifyAuthCard"
              alignment="TOP_CENTER" spacing="14.0"
              styleClass="spotify-auth-card"
              onMouseClicked="#swallowSpotifyAuthClick"
              AnchorPane.topAnchor="40.0" AnchorPane.bottomAnchor="40.0"
              AnchorPane.leftAnchor="180.0" AnchorPane.rightAnchor="180.0">

            <HBox alignment="CENTER_LEFT" spacing="12.0">
                <SVGPath content="M12 0C5.373 0 0 5.373 0 12s5.373 12 12 12 12-5.373 12-12S18.627 0 12 0zm5.508 17.302c-.216.353-.674.468-1.027.252-2.822-1.724-6.375-2.114-10.559-1.158-.403.092-.807-.16-.899-.562-.092-.403.16-.807.562-.899 4.582-1.047 8.513-.598 11.671 1.34.353.216.468.674.252 1.027zm1.47-3.262c-.272.443-.852.585-1.295.313-3.23-1.986-8.156-2.56-11.977-1.399-.499.151-1.031-.131-1.182-.63-.151-.499.131-1.031.63-1.182 4.373-1.328 9.805-.688 13.511 1.593.443.272.585.852.313 1.295zm.126-3.411c-3.874-2.3-10.264-2.512-13.966-1.388-.593.18-1.226-.156-1.406-.749-.18-.593.156-1.226.749-1.406 4.251-1.291 11.31-1.043 15.772 1.606.533.317.708 1.008.391 1.541-.317.533-1.008.708-1.54.391z"
                         fill="#1DB954" scaleX="1.4" scaleY="1.4"/>
                <Label text="Vincular Spotify" styleClass="spotify-auth-title"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label text="A L P H A" styleClass="alpha-wordmark"/>
                <Pane onMouseClicked="#closeSpotifyAuth" styleClass="icon-button">
                    <Line startX="12.0" startY="12.0" endX="22.0" endY="22.0" styleClass="icon-glyph"/>
                    <Line startX="12.0" startY="22.0" endX="22.0" endY="12.0" styleClass="icon-glyph"/>
                </Pane>
            </HBox>

            <!-- QR code (white panel for scanner contrast; rendered dynamically) -->
            <StackPane styleClass="spotify-auth-qr-panel">
                <ImageView fx:id="spotifyAuthQrView"
                           fitWidth="300.0" fitHeight="300.0"
                           preserveRatio="true"
                           smooth="false"/>
            </StackPane>

            <Label text="1 &#183; Escanea el c&#243;digo con la c&#225;mara del m&#243;vil&#10;2 &#183; Entra en tu Spotify: esta pantalla se conecta sola"
                   wrapText="true" textAlignment="CENTER"
                   styleClass="spotify-auth-hint"/>

            <Label fx:id="spotifyAuthStatusLabel"
                   text="Esperando conexi&#243;n..."
                   styleClass="spotify-auth-status"/>
        </VBox>
    </AnchorPane>

    <!-- Calendar Screen (Full-screen agenda: month grid + day event list) -->
    <AnchorPane fx:id="calendarLayer"
                visible="false"
                styleClass="alarm-sheet-backdrop"
                onMouseClicked="#closeCalendarOnOutsideClick"
                AnchorPane.topAnchor="0.0" AnchorPane.bottomAnchor="0.0"
                AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0">

        <VBox fx:id="calendarCard"
              spacing="14.0"
              styleClass="calendar-card"
              onMouseClicked="#swallowCalendarClick"
              AnchorPane.topAnchor="12.0" AnchorPane.bottomAnchor="12.0"
              AnchorPane.leftAnchor="14.0" AnchorPane.rightAnchor="14.0">

            <!-- Header: month navigation + close -->
            <HBox alignment="CENTER_LEFT" spacing="16.0">
                <Label text="&#8249;" onMouseClicked="#showPreviousMonth"
                       styleClass="calendar-nav-button"/>
                <Label fx:id="calendarTitleLabel" text="Agosto 2026"
                       minWidth="260.0" alignment="CENTER"
                       styleClass="calendar-title"/>
                <Label text="&#8250;" onMouseClicked="#showNextMonth"
                       styleClass="calendar-nav-button"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Pane onMouseClicked="#closeCalendarScreen" styleClass="icon-button">
                    <Line startX="12.0" startY="12.0" endX="22.0" endY="22.0" styleClass="icon-glyph"/>
                    <Line startX="12.0" startY="22.0" endX="22.0" endY="12.0" styleClass="icon-glyph"/>
                </Pane>
            </HBox>

            <!-- Body: month grid (left) + selected-day events (right) -->
            <HBox spacing="22.0" VBox.vgrow="ALWAYS">

                <VBox spacing="6.0">
                    <!-- Weekday header: L M X J V S D -->
                    <HBox spacing="6.0">
                        <Label text="L" minWidth="82.0" alignment="CENTER" styleClass="calendar-weekday"/>
                        <Label text="M" minWidth="82.0" alignment="CENTER" styleClass="calendar-weekday"/>
                        <Label text="X" minWidth="82.0" alignment="CENTER" styleClass="calendar-weekday"/>
                        <Label text="J" minWidth="82.0" alignment="CENTER" styleClass="calendar-weekday"/>
                        <Label text="V" minWidth="82.0" alignment="CENTER" styleClass="calendar-weekday"/>
                        <Label text="S" minWidth="82.0" alignment="CENTER" styleClass="calendar-weekday"/>
                        <Label text="D" minWidth="82.0" alignment="CENTER" styleClass="calendar-weekday"/>
                    </HBox>
                    <!-- Week rows built dynamically -->
                    <VBox fx:id="calendarGrid" spacing="7.0"/>
                </VBox>

                <!-- Selected day agenda -->
                <VBox spacing="10.0" HBox.hgrow="ALWAYS">
                    <Label fx:id="calendarSelectedDateLabel" text=""
                           wrapText="true"
                           styleClass="calendar-selected-date"/>
                    <ScrollPane
                                fitToWidth="true"
                                hbarPolicy="NEVER"
                                vbarPolicy="AS_NEEDED"
                                styleClass="alarm-list-scroll"
                                VBox.vgrow="ALWAYS" HBox.hgrow="ALWAYS">
                        <VBox fx:id="calendarEventList" spacing="10.0"/>
                    </ScrollPane>
                </VBox>
            </HBox>
        </VBox>
    </AnchorPane>

    <!-- Alpha Speech Bubble (Topmost transient alert; Alpha "says" remote messages) -->
    <VBox
          alignment="CENTER" spacing="0"
          AnchorPane.bottomAnchor="24.0"
          AnchorPane.leftAnchor="48.0"
          AnchorPane.rightAnchor="48.0">

        <HBox fx:id="notificationBanner"
              visible="false"
              alignment="CENTER_LEFT" spacing="18.0"
              maxWidth="820.0"
              styleClass="notification-bubble">

            <!-- Avatar: pulsing aurora glow behind a gradient ring with robot face -->
            <StackPane styleClass="notification-avatar"
                       minWidth="62.0" minHeight="62.0">
                <Region fx:id="notificationAvatarGlow"
                        visible="false"
                        styleClass="notification-avatar-glow"/>
                <!-- Her face, drawn from scratch: antenna, head, two eyes, a smile -->
                <Group>
                    <Circle centerX="31.0" centerY="15.4" radius="2.3" styleClass="alpha-face"/>
                    <Line startX="31.0" startY="17.4" endX="31.0" endY="23.4" styleClass="alpha-face"/>
                    <Rectangle x="16.0" y="23.0" width="30.0" height="24.0"
                               arcWidth="10.0" arcHeight="10.0" styleClass="alpha-face"/>
                    <Rectangle x="11.0" y="30.5" width="4.0" height="9.0"
                               arcWidth="3.0" arcHeight="3.0" styleClass="alpha-face"/>
                    <Rectangle x="47.0" y="30.5" width="4.0" height="9.0"
                               arcWidth="3.0" arcHeight="3.0" styleClass="alpha-face"/>
                    <Circle centerX="25.0" centerY="33.0" radius="2.6" styleClass="alpha-face-eye"/>
                    <Circle centerX="37.0" centerY="33.0" radius="2.6" styleClass="alpha-face-eye"/>
                    <SVGPath content="M25.4 40.4c1.8 2.3 9.4 2.3 11.2 0"
                             styleClass="alpha-face-mouth"/>
                </Group>
            </StackPane>

            <!-- Message content -->
            <VBox alignment="CENTER_LEFT" spacing="3.0" maxWidth="660.0">
                <Label text="A L P H A"
                       styleClass="notification-author"/>
                <Label fx:id="notificationLabel"
                       text=""
                       styleClass="notification-text"
                       wrapText="true"/>
            </VBox>

            <!-- Spacer -->
            <Region HBox.hgrow="ALWAYS"/>

            <!-- Touch Dismiss Button -->
            <Pane onMouseClicked="#dismissNotification" styleClass="icon-button">
                <Line startX="12.0" startY="12.0" endX="22.0" endY="22.0" styleClass="icon-glyph"/>
                <Line startX="12.0" startY="22.0" endX="22.0" endY="12.0" styleClass="icon-glyph"/>
            </Pane>
        </HBox>

        <!-- Speech tail pointing down from the bubble -->
        <SVGPath content="M0 0 L20 0 L10 9 Z"
                 fill="rgba(16, 31, 56, 0.97)" scaleX="1.6" scaleY="1.6"/>
    </VBox>

    <!-- Alarm Manager Sheet (Modal: list, add, toggle and delete alarms by touch) -->
    <AnchorPane fx:id="alarmManagerLayer"
                visible="false"
                styleClass="alarm-sheet-backdrop"
                onMouseClicked="#closeAlarmManagerOnOutsideClick"
                AnchorPane.topAnchor="0.0" AnchorPane.bottomAnchor="0.0"
                AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0">

        <!-- Full-screen touch-friendly card -->
        <VBox fx:id="alarmSheetCard"
              alignment="TOP_CENTER" spacing="10.0"
              styleClass="alarm-sheet-card"
              onMouseClicked="#swallowAlarmCardClick"
              AnchorPane.topAnchor="14.0" AnchorPane.bottomAnchor="14.0"
              AnchorPane.leftAnchor="14.0" AnchorPane.rightAnchor="14.0">

            <!-- Header -->
            <HBox alignment="CENTER_LEFT" spacing="12.0">
                <Pane prefWidth="24.0" prefHeight="24.0" mouseTransparent="true">
                    <Circle centerX="12.0" centerY="13.2" radius="7.2" styleClass="icon-line icon-line-ember"/>
                    <Line startX="12.0" startY="13.2" endX="12.0" endY="8.8" styleClass="icon-line icon-line-ember"/>
                    <Line startX="12.0" startY="13.2" endX="15.3" endY="15.1" styleClass="icon-line icon-line-ember"/>
                    <Line startX="5.0" startY="3.6" endX="8.4" endY="7.0" styleClass="icon-line icon-line-ember"/>
                    <Line startX="19.0" startY="3.6" endX="15.6" endY="7.0" styleClass="icon-line icon-line-ember"/>
                </Pane>
                <Label text="Alarmas" styleClass="alarm-sheet-title"/>
                <Region/>
                <Pane onMouseClicked="#closeAlarmManager" styleClass="icon-button">
                    <Line startX="12.0" startY="12.0" endX="22.0" endY="22.0" styleClass="icon-glyph"/>
                    <Line startX="12.0" startY="22.0" endX="22.0" endY="12.0" styleClass="icon-glyph"/>
                </Pane>
            </HBox>

            <!-- Alarm Rows (built dynamically) -->
            <ScrollPane fx:id="alarmListScroll"
                        fitToWidth="true"
                        hbarPolicy="NEVER"
                        vbarPolicy="AS_NEEDED"
                        styleClass="alarm-list-scroll">
                <VBox fx:id="alarmListContainer" spacing="12.0"/>
            </ScrollPane>

            <!-- Empty hint -->
            <Label fx:id="alarmEmptyHint"
                   text="No hay alarmas todav&#237;a. Crea una con el bot&#243;n de abajo."
                   wrapText="true"
                   styleClass="alarm-empty-hint"/>

            <!-- Add Button -->
            <Label fx:id="addAlarmButton"
                   text="+  Nueva alarma"
                   onMouseClicked="#showNewAlarmEditor"
                   alignment="CENTER"
                   styleClass="add-alarm-button"/>

            <!-- Editor (hidden until adding/editing) -->
            <VBox fx:id="alarmEditorPane"
                  visible="false" managed="false"
                  alignment="TOP_CENTER" spacing="10.0"
                  styleClass="alarm-editor-pane">

                <Label fx:id="editorTimePreview"
                       text="07:00"
                       styleClass="alarm-editor-preview"/>

                <!-- Hour / Minute steppers -->
                <HBox alignment="CENTER" spacing="56.0">
                    <VBox alignment="CENTER" spacing="2.0">
                        <Label text="Hora" styleClass="alarm-stepper-caption"/>
                        <HBox alignment="CENTER" spacing="10.0">
                            <Label text="&#8722;"
                                   onMouseClicked="#decrementHour"
                                   styleClass="stepper-button"/>
                            <Label fx:id="editorHourValue" text="07" styleClass="stepper-value"/>
                            <Label text="+"
                                   onMouseClicked="#incrementHour"
                                   styleClass="stepper-button"/>
                        </HBox>
                    </VBox>

                    <VBox alignment="CENTER" spacing="2.0">
                        <Label text="Minuto" styleClass="alarm-stepper-caption"/>
                        <HBox alignment="CENTER" spacing="10.0">
                            <Label text="&#8722;"
                                   onMouseClicked="#decrementMinute"
                                   styleClass="stepper-button"/>
                            <Label fx:id="editorMinuteValue" text="00" styleClass="stepper-value"/>
                            <Label text="+"
                                   onMouseClicked="#incrementMinute"
                                   styleClass="stepper-button"/>
                        </HBox>
                    </VBox>
                </HBox>

                <!-- Repeat mode: one-shot vs recurring -->
                <HBox alignment="CENTER" spacing="12.0">
                    <Label fx:id="modeOnceButton"
                           text="Solo una vez"
                           onMouseClicked="#selectOnceMode"
                           styleClass="alarm-mode-button"/>
                    <Label fx:id="modeRepeatButton"
                           text="Repetir"
                           onMouseClicked="#selectRepeatMode"
                           styleClass="alarm-mode-button-selected"/>
                </HBox>

                <!-- Day-of-week chips (built dynamically) -->
                <VBox fx:id="dayChipsSection" alignment="CENTER" spacing="4.0">
                    <HBox fx:id="dayChipsRow" alignment="CENTER" spacing="10.0"/>
                    <Label fx:id="editorDaysHint" text="" styleClass="alarm-days-hint"/>
                </VBox>

                <!-- Save / Cancel -->
                <HBox alignment="CENTER" spacing="16.0">
                    <Label text="Cancelar"
                           onMouseClicked="#cancelAlarmEditor"
                           styleClass="alarm-editor-cancel"/>
                    <Label text="Guardar"
                           onMouseClicked="#saveAlarmFromEditor"
                           styleClass="alarm-editor-save"/>
                </HBox>
            </VBox>
        </VBox>
    </AnchorPane>

    <!-- Night Dim Overlay (topmost: screen-saver dim while idle at night; tap to wake) -->
    <AnchorPane fx:id="dimLayer"
                visible="false" opacity="0.0"
                styleClass="dim-overlay"
                AnchorPane.topAnchor="0.0" AnchorPane.bottomAnchor="0.0"
                AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0"/>

    <!-- Alarm Ring Overlay (Topmost layer when an alarm fires) -->
    <AnchorPane fx:id="alarmRingLayer"
                visible="false" opacity="0.0"
                styleClass="alarm-ring-background"
                AnchorPane.topAnchor="0.0" AnchorPane.bottomAnchor="0.0"
                AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0">

        <!-- Pulsing glow backdrop (animated opacity only) -->
        <AnchorPane fx:id="alarmGlowPane"
                    visible="false"
                    styleClass="alarm-glow"
                    AnchorPane.topAnchor="0.0" AnchorPane.bottomAnchor="0.0"
                    AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0"/>

        <!-- Center content -->
        <VBox alignment="CENTER" spacing="14.0"
              AnchorPane.topAnchor="0.0" AnchorPane.bottomAnchor="90.0"
              AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0">

            <!-- Her own alarm glyph instead of an emoji: same hand as every other icon -->
            <Pane prefWidth="92.0" prefHeight="86.0" mouseTransparent="true">
                <Circle centerX="46.0" centerY="50.0" radius="38.0" styleClass="alarm-ring-halo"/>
                <Circle centerX="46.0" centerY="50.0" radius="27.0" styleClass="alarm-ring-glyph"/>
                <Line startX="46.0" startY="50.0" endX="46.0" endY="32.0" styleClass="alarm-ring-glyph"/>
                <Line startX="46.0" startY="50.0" endX="59.0" endY="56.5" styleClass="alarm-ring-glyph"/>
                <Line startX="22.0" startY="14.0" endX="34.0" endY="26.0" styleClass="alarm-ring-glyph"/>
                <Line startX="70.0" startY="14.0" endX="58.0" endY="26.0" styleClass="alarm-ring-glyph"/>
            </Pane>
            <Label fx:id="alarmRingGreetingLabel"
                   text=""
                   styleClass="alarm-ring-greeting"/>
            <Label fx:id="alarmRingTimeLabel"
                   text="--:--"
                   styleClass="alarm-ring-time"/>
            <Label fx:id="alarmRingTitleLabel"
                   text="Alarma"
                   styleClass="alarm-ring-title"/>
        </VBox>

        <!-- Touch buttons: Snooze + Dismiss -->
        <HBox alignment="CENTER" spacing="26.0"
              AnchorPane.bottomAnchor="70.0"
              AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0">

            <Label
                   text="Posponer 5 min"
                   alignment="CENTER"
                   onMouseClicked="#snoozeActiveAlarm"
                   styleClass="alarm-snooze-button"/>
            <Label
                   text="Apagar"
                   alignment="CENTER"
                   onMouseClicked="#dismissActiveAlarm"
                   styleClass="alarm-dismiss-button"/>
        </HBox>
    </AnchorPane>

</AnchorPane>
