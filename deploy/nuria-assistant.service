[Unit]
Description=Nuria Assistant JavaFX Kiosk UI (1024x600)
# Wants (not Requires): a broken voice backend must never keep the clock,
# weather, calendar and alarms off the screen - the UI just shows a grey orb
# if the backend is unreachable.
Wants=nuria-voice.service network-online.target
After=graphical.target display-manager.service network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=__USER__
WorkingDirectory=__PROJECT_DIR__

# Wait for the desktop session's X display (XWayland on Raspberry Pi OS
# Bookworm). The UI only renders once someone is logged in on :0, so desktop
# autologin must be enabled - install.sh checks for it and can turn it on.
ExecStartPre=/bin/bash -c 'for i in $(seq 1 60); do [ -e /tmp/.X11-unix/X0 ] && exit 0; sleep 2; done; echo "No X display :0 found"; exit 1'

Environment=DISPLAY=:0
Environment=XAUTHORITY=__HOME__/.Xauthority
# Alarms and TTS play through the logged-in user's PipeWire/Pulse session, so
# the service needs that session's runtime dir and D-Bus socket.
Environment=XDG_RUNTIME_DIR=/run/user/__UID__
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/__UID__/bus

# Kiosk: no title bar, no window buttons, window pinned over the whole screen
# and above the desktop panel. Also hides the mouse pointer (the Pi is touch
# only). Set to false on a dev Pi to get a normal window back for debugging.
Environment=KIOSK_MODE=true

# Per-installation keys that live outside the jar (OpenWeather, Spotify,
# Telegram, OWNER_NAME, ...). install.sh writes a commented template here; the
# leading '-' means the unit still starts when the file does not exist.
EnvironmentFile=-__HOME__/.alpha/alpha.env

# Pi 3 tuned JVM (rendered by install.sh):
#   -Xms64m -Xmx384m          capped heap on the 1 GB box
#   -XX:+UseSerialGC          lowest overhead collector at that heap size
#   -XX:TieredStopAtLevel=1   C1-only JIT: far less compilation on slow ARM
#   -Dprism.order=sw          software rendering only, no flaky GL/Mesa probe
#   -XX:+AutoCreateSharedArchive / -XX:SharedArchiveFile
#                             class-data-sharing archive created on the first
#                             run and reused afterwards: skips class parsing
#                             and verification at every boot
# See PIAGENT.md ("Rendimiento") to measure and to trade any of these off.
Environment=JDK_JAVA_OPTIONS='__JVM_OPTIONS__'

ExecStart=__EXEC_START__
Restart=always
RestartSec=10

[Install]
WantedBy=graphical.target
