[Unit]
Description=Nuria Assistant JavaFX Kiosk UI (1024x600)
Requires=nuria-voice.service
After=graphical.target nuria-voice.service network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=__USER__
WorkingDirectory=__PROJECT_DIR__

# Wait for the desktop session (XWayland on Raspberry Pi OS Bookworm)
ExecStartPre=/bin/bash -c 'for i in $(seq 1 60); do [ -e /tmp/.X11-unix/X0 ] && exit 0; sleep 2; done; echo "No X display :0 found"; exit 1'

Environment=DISPLAY=:0

ExecStart=/bin/bash -lc 'cd __PROJECT_DIR__ && ./mvnw javafx:run'
Restart=always
RestartSec=10

[Install]
WantedBy=graphical.target
