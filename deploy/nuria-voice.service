[Unit]
Description=Nuria Voice Backend (wake word + STT + LLM + TTS)
After=network-online.target sound.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=__USER__
WorkingDirectory=__PROJECT_DIR__/voice-backend
ExecStart=__PROJECT_DIR__/voice-backend/.venv/bin/python -m uvicorn main:app --host 0.0.0.0 --port 8090
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1
Environment=XDG_RUNTIME_DIR=/run/user/__UID__
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/__UID__/bus

# Same per-installation key file as the kiosk unit: an env var set here wins
# over voice-backend/.env (python-dotenv does not override the process
# environment), so GROQ_API_KEY and the Piper paths can live in one place
# instead of two. The leading '-' = the file is optional.
EnvironmentFile=-__HOME__/.alpha/alpha.env

[Install]
WantedBy=multi-user.target
