[Unit]
Description=Nuria Voice Backend (wake word + STT + LLM + TTS)
After=network-online.target sound.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=__USER__
WorkingDirectory=__PROJECT_DIR__/voice-backend
ExecStart=__PROJECT_DIR__/voice-backend/.venv/bin/python -m uvicorn main:app --host 0.0.0.0 --port 8090
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
